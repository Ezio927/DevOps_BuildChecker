{
  "uid": "a03-e12",
  "title": "A03 · E12 任务与全量检测",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "业务服务抓取状态",
      "datasource": {"type": "prometheus", "uid": "a03-prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 9},
      "targets": [{"refId": "A", "expr": "up{job=~\"a03-.*\"}", "legendFormat": "{{job}}"}]
    },
    {
      "id": 2, "type": "timeseries", "title": "E12 任务终态累计次数",
      "datasource": {"type": "prometheus", "uid": "a03-prometheus"},
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 9},
      "targets": [{"refId": "A", "expr": "a03_jobs_total", "legendFormat": "{{status}}"}]
    },
    {
      "id": 3, "type": "timeseries", "title": "近一分钟完成任务的平均耗时",
      "datasource": {"type": "prometheus", "uid": "a03-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"x": 0, "y": 9, "w": 12, "h": 9},
      "targets": [{"refId": "A", "expr": "sum(rate(a03_jobs_duration_seconds_sum[1m])) / (sum(rate(a03_jobs_duration_seconds_count[1m])) > 0)", "legendFormat": "E12"}]
    },
    {
      "id": 4, "type": "timeseries", "title": "BuildChecker 全量检测完成次数（进程启动后）",
      "datasource": {"type": "prometheus", "uid": "a03-prometheus"},
      "gridPos": {"x": 12, "y": 9, "w": 12, "h": 9},
      "targets": [{"refId": "A", "expr": "a03_checks_total", "legendFormat": "{{status}}"}]
    }
  ]
}
