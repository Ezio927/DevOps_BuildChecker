{
  "name": "a03-444-livesample",
  "networks": {
    "default": {
      "name": "a03-444-livesample_default",
      "ipam": {}
    }
  },
  "services": {
    "api": {
      "command": [
        "python",
        "-u",
        "service.py",
        "api"
      ],
      "depends_on": {
        "worker": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "dns_opt": [
        "timeout:1",
        "attempts:1"
      ],
      "entrypoint": null,
      "environment": {
        "WORKER_URL": "http://worker:8080/check"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "from urllib.request import urlopen; urlopen('http://127.0.0.1:8080/health', timeout=2).close()"
        ],
        "timeout": "3s",
        "interval": "3s",
        "retries": 10
      },
      "image": "course-e11e12:241880444",
      "init": true,
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 8080,
          "published": "28541",
          "protocol": "tcp"
        }
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "app",
          "target": "/app",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        }
      ],
      "working_dir": "/app"
    },
    "grafana": {
      "command": null,
      "entrypoint": null,
      "environment": {
        "GF_USERS_ALLOW_SIGN_UP": "false"
      },
      "image": "m.daocloud.io/docker.io/grafana/grafana@sha256:488984b716c0862639f91a698adbe2862677a5a07bad42da5f03f3030883b205",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 3000,
          "published": "28543",
          "protocol": "tcp"
        }
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "monitoring/grafana/provisioning",
          "target": "/etc/grafana/provisioning",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "bind",
          "source": "monitoring/grafana/dashboards",
          "target": "/var/lib/grafana/dashboards",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "volume",
          "source": "grafana-data",
          "target": "/var/lib/grafana",
          "volume": {}
        }
      ]
    },
    "prometheus": {
      "command": [
        "--config.file=/etc/prometheus/prometheus.yml",
        "--storage.tsdb.path=/prometheus",
        "--storage.tsdb.retention.time=2d"
      ],
      "entrypoint": null,
      "image": "m.daocloud.io/docker.io/prom/prometheus@sha256:38c3b05c3bc744ff1b0b7b4eb82196026442845e62a1e2073795565da506d7a2",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 9090,
          "published": "28542",
          "protocol": "tcp"
        }
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "monitoring/prometheus.yml",
          "target": "/etc/prometheus/prometheus.yml",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "volume",
          "source": "prometheus-data",
          "target": "/prometheus",
          "volume": {}
        }
      ]
    },
    "worker": {
      "command": [
        "python",
        "-u",
        "service.py",
        "worker"
      ],
      "entrypoint": null,
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "from urllib.request import urlopen; urlopen('http://127.0.0.1:8080/health', timeout=2).close()"
        ],
        "timeout": "3s",
        "interval": "3s",
        "retries": 10
      },
      "image": "course-e11e12:241880444",
      "init": true,
      "networks": {
        "default": null
      },
      "volumes": [
        {
          "type": "bind",
          "source": "app",
          "target": "/app",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        }
      ],
      "working_dir": "/app"
    }
  },
  "volumes": {
    "grafana-data": {
      "name": "a03-444-livesample_grafana-data"
    },
    "prometheus-data": {
      "name": "a03-444-livesample_prometheus-data"
    }
  },
  "x-app": {
    "healthcheck": {
      "interval": "3s",
      "retries": 10,
      "test": [
        "CMD",
        "python",
        "-c",
        "from urllib.request import urlopen; urlopen('http://127.0.0.1:8080/health', timeout=2).close()"
      ],
      "timeout": "3s"
    },
    "image": "course-e11e12:241880444",
    "init": true,
    "volumes": [
      "./app:/app:ro"
    ],
    "working_dir": "/app"
  }
}
